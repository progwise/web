---
import "../styles/global.css";
const team = [
  {
    role: "Consultant",
    initial: "C",
    task: "Understands your business",
    className: "consultant",
  },
  {
    role: "Designer",
    initial: "D",
    task: "Makes ideas tangible",
    className: "designer",
  },
  {
    role: "Developer",
    initial: "E",
    task: "Builds and verifies",
    className: "developer",
  },
  {
    role: "Progwise expert",
    initial: "P",
    task: "Brings human judgment",
    className: "expert",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="Engineer your own software with Progwise. Our vision brings business people and designers together with AI specialists, human experts, testing, and controlled deployment."
    />
    <meta name="theme-color" content="#162d29" />
    <meta
      property="og:title"
      content="Progwise — Your idea. A team to build it."
    />
    <meta
      property="og:description"
      content="Your ideas, engineered together. Explore our vision for AI specialists, human expertise on demand, and a shared virtual office."
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.progwise.net/" />
    <link rel="canonical" href="https://www.progwise.net/" />
    <link rel="icon" href="/favicon.svg" />
    <title>Progwise — Your idea. A team to build it.</title>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <header class="wrap">
      <a class="brand" href="#" aria-label="Progwise home">
        progwise<span>✳</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="#vision">The idea</a>
        <a href="#how">How it works</a>
        <a class="nav-contact" href="#contact">
          Let’s talk <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" id="vision">
        <div class="hero-copy">
          <p class="eyebrow">
            <span class="dot"></span> THE NEXT CHAPTER OF PROGWISE
          </p>
          <h1>
            Your idea.
            <br />A team to <em>build it.</em>
          </h1>
          <p class="intro">
            Engineer your own software. We’re building a place where business
            people and designers work with AI specialists and experienced human
            engineers—from the first idea to a product people can use.
          </p>
          <div class="hero-actions">
            <a class="button" href="#office">
              Step inside the idea <span aria-hidden="true">↗</span>
            </a>
            <span>
              A platform in development.
              <br />
              An invitation to shape it.
            </span>
          </div>
        </div>
        <div
          class="office"
          id="office"
          aria-label="Illustrative concept of a Progwise virtual office"
        >
          <div class="office-bar">
            <span>
              <span class="dot"></span> Your project office
            </span>
            <span class="concept">CONCEPT PREVIEW</span>
          </div>
          <div class="floor">
            <div class="room meeting">
              <span class="room-label">LET’S TALK ABOUT YOUR IDEA</span>
              <div class="meeting-table">
                <span class="seat customer">You</span>
                <span class="seat ai">AI</span>
                <span class="table-note">
                  What would you
                  <br />
                  like to build?
                </span>
              </div>
            </div>
            <div class="room team-room">
              <span class="room-label">YOUR TEAM</span>
              <div class="desks">
                {team.map((member) => (
                  <div class:list={["desk", member.className]}>
                    <span class="avatar">{member.initial}</span>
                    <strong>{member.role}</strong>
                    <small>
                      {member.className === "expert" ? "HUMAN" : "AI"}
                    </small>
                  </div>
                ))}
              </div>
            </div>
            <div class="hall">
              <span class="plant">✳</span>
              <span>
                Ideas become conversations.
                <br />
                Conversations become software.
              </span>
              <span class="plant">✳</span>
            </div>
          </div>
          <div class="office-caption">
            <span>A shared space for people + AI</span>
            <a href="#how">Explore the workflow ↓</a>
          </div>
        </div>
      </section>
      <section class="statement">
        <div class="wrap statement-inner">
          <p class="eyebrow">SOFTWARE DEVELOPMENT, REIMAGINED</p>
          <p>
            Our ambition is products in weeks instead of months.
            <br />
            <span>
              At a fraction of the cost of hiring your own development team.
            </span>
          </p>
        </div>
      </section>
      <section class="wrap section" id="how">
        <div class="section-heading">
          <p class="eyebrow">FROM FIRST CONVERSATION TO WHAT’S NEXT</p>
          <h2>
            A whole team.
            <br />
            One shared understanding.
          </h2>
          <p>
            Bring your business knowledge and creative direction. Build
            alongside AI specialists, with consulting, engineering guardrails,
            testing, and deployment strategies built into the process.
          </p>
        </div>
        <div class="steps">
          <article>
            <span class="step-icon" aria-hidden="true">
              ↗
            </span>
            <h3>Bring the problem.</h3>
            <p>
              Explore directions with a consultant. Describe the problem,
              challenge assumptions, and choose an approach. Turn your knowledge
              into requirements, designs, and a plan you can act on.
            </p>
          </article>
          <article>
            <span class="step-icon" aria-hidden="true">
              ⌘
            </span>
            <h3>Assemble your team.</h3>
            <p>
              Add AI specialists as the work needs them. Bring in a human
              database, web, design, or scaling engineer for hands-on expertise.
              Meet in the shared office, try previews, and shape the product
              together.
            </p>
          </article>
          <article>
            <span class="step-icon" aria-hidden="true">
              ↻
            </span>
            <h3>Build through to launch.</h3>
            <p>
              Move from an idea to working software through code review,
              automated testing, and controlled deployment. Keep the team’s
              context for maintenance, growth, and the next change.
            </p>
          </article>
        </div>
      </section>
      <section class="technical wrap" id="design">
        <div class="technical-copy">
          <p class="eyebrow">CREATIVE FREEDOM. ENGINEERING DISCIPLINE.</p>
          <h2>
            Bring your vision.
            <br />
            Build with confidence.
          </h2>
          <p>
            Business people understand the work. Designers understand the
            experience. Progwise is being designed to help both turn that
            expertise into software—with AI doing the implementation alongside
            them.
          </p>
          <p>
            Explore ideas and make changes within an agreed scope. Guardrails
            define what agents can access and change. Reviews and tests check
            the result, and a deployment strategy takes it into production.
          </p>
          <details>
            <summary>
              How would the engineering guardrails work?{" "}
              <span aria-hidden="true">+</span>
            </summary>
            <p>
              Each specialist would work with scoped permissions and isolated
              previews. Changes to shared services, authentication, databases,
              or infrastructure would involve the responsible technical owner.
            </p>
            <p>
              Automated checks and integration tests would verify critical
              journeys before release. Deployment plans would cover monitoring
              and rollback. Consultants and engineers would help choose an
              architecture suited to your product and its growth.
            </p>
          </details>
        </div>
        <div class="change-card">
          <div class="change-header">
            <span class="dot"></span> THE PROPOSED WORKFLOW
          </div>
          <div class="request">
            <span class="request-label">YOUR IDEA</span>
            <p>
              “We know what our business needs.
              <br />
              Let’s build it together.”
            </p>
          </div>
          <ol>
            <li>
              <span>01</span>
              <div>
                <strong>Explore with AI</strong>
                <small>Direction, requirements, design</small>
              </div>
            </li>
            <li>
              <span>02</span>
              <div>
                <strong>Try the preview</strong>
                <small>Review the change in context</small>
              </div>
            </li>
            <li>
              <span>03</span>
              <div>
                <strong>Review &amp; verify</strong>
                <small>Code, integrations, critical journeys</small>
              </div>
            </li>
            <li>
              <span>04</span>
              <div>
                <strong>Release with control</strong>
                <small>Approved changes, traceable history</small>
              </div>
            </li>
          </ol>
          <div class="boundary">
            AI specialists + human expertise, as needed
          </div>
        </div>
      </section>
      <section class="wrap section funding">
        <div>
          <p class="eyebrow">A CLEAR VIEW OF THE INVESTMENT</p>
          <h2>
            Fund a month.
            <br />
            See what moves forward.
          </h2>
        </div>
        <div>
          <p class="lead">
            Our planned model is monthly, paid upfront. Agree the budget and
            priorities. Work begins when payment arrives.
          </p>
          <p>
            The complete project has a forecast for investment and timing. As
            requirements become clearer, that forecast evolves—with the reasons
            and options visible to you.
          </p>
          <div class="funding-items">
            <span>Monthly funding</span>
            <span>Progress &amp; decisions</span>
            <span>Updated cost forecasts</span>
            <span>Expected running costs</span>
          </div>
        </div>
      </section>
      <section class="contact" id="contact">
        <div class="wrap contact-inner">
          <p class="eyebrow">BUILT ON EXPERIENCE. OPEN TO POSSIBILITIES.</p>
          <h2>
            What would you
            <br />
            build with a team like this?
          </h2>
          <p>
            We’re shaping Progwise with people who want to build. Bring your
            business idea, your design, or your engineering challenge—and help
            shape a new way to create software together.
          </p>
          <a
            class="button light"
            href="mailto:info@progwise.net?subject=The%20next%20chapter%20of%20Progwise"
          >
            Start a conversation <span aria-hidden="true">↗</span>
          </a>
          <span class="email">info@progwise.net</span>
        </div>
      </section>
    </main>
    <footer class="wrap">
      <a class="brand" href="#">
        progwise<span>✳</span>
      </a>
      <span>© {new Date().getFullYear()} Progwise Ltd.</span>
      <span>Our direction, taking shape.</span>
    </footer>
  </body>
</html>
